# Copy this file to .env.test for tests, or .env for local application settings.
# Never commit either local file.

# Set to true to opt into the live and manual tests below. They are skipped by default.
RUN_LIVE_TESTS=false

# AI settings used by BetterGit and AiSystemLiveTest.
AI_API_KEY=replace-with-your-gemini-api-key
AI_API_MODEL=gemini-flash-latest
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
AI_INPUT=Explain how AI works in a few words.

# Local Git repository used by JGitManagerPathTest.
GIT_REPOSITORY_PATH=/absolute/path/to/your/local/repository

# Project modified by the opt-in InitCommandPathTest. Use a disposable project while testing.
BETTERGIT_INIT_PROJECT_PATH=/absolute/path/to/a/disposable/project

# Optional GitHub push settings. Use either an HTTPS or SSH remote URL.
GITHUB_REMOTE_URL=https://github.com/your-github-username/your-repository.git
# GITHUB_REMOTE_URL=git@github.com:your-github-username/your-repository.git

# Required only when using HTTPS authentication without a configured Git credential manager.
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=replace-with-a-github-fine-grained-personal-access-token
